# MySQL (schema Prisma dùng provider = "mysql")
# Local:
DATABASE_URL="mysql://root:matkhau0107@localhost:3306/system"

# Render / production — BẮT BUỘC mysql://, KHÔNG dùng postgresql:// (Neon)
# Ví dụ Railway / PlanetScale / Aiven:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# App
PORT=3000
CORS_ORIGIN=*

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail SMTP — App Password, không dấu cách
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ImgBB — upload ảnh (avatar, câu hỏi...)
# Lấy API key miễn phí: https://api.imgbb.com/
IMGBB_API_KEY=your-imgbb-api-key
# Tuỳ chọn: tự xóa ảnh sau N giây (60–15552000). Bỏ trống = lưu vĩnh viễn.
# IMGBB_EXPIRATION=15552000
# Tuỳ chọn: giới hạn dung lượng upload (MB), mặc định 5
# UPLOAD_MAX_SIZE_MB=5
