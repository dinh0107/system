# Neon (recommended): Dashboard → Connect → copy "Connection string" (pooled or direct)
# Must include sslmode=require (Neon adds this by default)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Local Postgres (optional)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/system?schema=public"

# App
PORT=3000
# CORS: * = all origins (dev), or comma-separated URLs
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=*

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail SMTP (for OTP emails) — App Password, không dấu cách
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
